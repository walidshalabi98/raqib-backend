# --- Required (the server refuses to start without these) ---
DATABASE_URL=postgresql://user:password@localhost:5432/raqib?schema=public
DIRECT_URL=postgresql://user:password@localhost:5432/raqib?schema=public
# At least 32 characters each. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
ANTHROPIC_API_KEY=sk-ant-...

# --- AI ---
AI_MODEL_MAIN=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-5-5
# Optional: Voyage AI embeddings for the KPI Assistant (keyword search is used without it)
VOYAGE_API_KEY=

# --- File storage ---
# Documents are stored in a PRIVATE Supabase Storage bucket and served through
# 5-minute signed URLs. Required in production. In development, files are kept
# in LOCAL_STORAGE_DIR (never served publicly) when these are empty.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=documents
LOCAL_STORAGE_DIR=storage

# --- Webhooks ---
# Optional shared secret. When set, webhook requests that carry an
# X-Raqib-Signature header (sha256=<hex HMAC of the raw body>) are verified with it.
WEBHOOK_SECRET=

# --- Web ---
APP_URL=http://localhost:5173
# Public URL of this API (used in local signed download links)
API_URL=http://localhost:3001
# Extra allowed browser origins, comma-separated (APP_URL is always allowed)
CORS_ORIGINS=
PORT=3001
NODE_ENV=development

# --- Other services ---
REDIS_URL=redis://localhost:6379
RESEND_API_KEY=

# --- Seed (prisma/seed.ts) ---
# Required outside development. The seed never runs when NODE_ENV=production.
SEED_PASSWORD=
