# --- Required (the server refuses to start without these) ---
# Local Postgres. On Supabase do NOT add ?schema=public: Prisma then sets search_path to public
# only, which hides pgvector in Supabase's `extensions` schema (see docs/DATA_MODEL.md §9).
DATABASE_URL=postgresql://user:password@localhost:5432/raqib?schema=public
DIRECT_URL=postgresql://user:password@localhost:5432/raqib?schema=public
# At least 32 characters each, and different from each other (the server refuses one value for both).
# Generate each one separately with: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
ANTHROPIC_API_KEY=sk-ant-...

# --- AI ---
# Model ids live here only; services choose a tier (main or fast), never a model id.
# Blank (AI_MODEL_MAIN=) uses the default shown here.
AI_MODEL_MAIN=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-5-5
# Timeout per AI request in milliseconds (1000-3600000). Whole-framework generation passes a longer one.
AI_REQUEST_TIMEOUT_MS=60000
# Retries after rate limits, overloads, server errors and network failures (0-10; backoff 1s, 2s, 4s... at most 30s).
AI_MAX_RETRIES=3
# "default": on Sonnet 5.5 / Opus 5 / Opus 5.5, a request declined for some refusal categories
# (for Sonnet 5.5: cyber and frontier_llm) is re-run server-side on Anthropic's default fallback
# model; other declines stay refusals. "off": refusals are returned as errors.
AI_REFUSAL_FALLBACK=default
# Months an AiCall log row is kept (1-120, default 24). The worker deletes older rows every night
# at 03:30 Asia/Hebron; `npm run ai-calls:prune` shows (and with --apply deletes) them by hand.
AI_CALL_RETENTION_MONTHS=24
# Optional: Voyage AI embeddings for the KPI Assistant (keyword search is used without it)
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4
# Daily AI budget per organisation in US$ (sum of the estimated cost of every AI call in the last 24 hours).
# KPI suggestion requests are refused (429 budget_reached) once it is spent. 0 turns the check off. Default 20.
AI_ORG_DAILY_BUDGET_USD=20

# --- File storage ---
# Documents are stored in a PRIVATE Supabase Storage bucket and served through
# 5-minute signed URLs. Required in production. In development, files are kept
# in LOCAL_STORAGE_DIR (never served publicly) when these are empty.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=documents
LOCAL_STORAGE_DIR=storage

# --- Webhooks ---
# Optional shared secret. When set, webhook requests that carry an
# X-Raqib-Signature header (sha256=<hex HMAC of the raw body>) are verified with it.
WEBHOOK_SECRET=

# --- Web ---
APP_URL=http://localhost:5173
# Public URL of this API (used in local signed download links)
API_URL=http://localhost:3001
# Extra allowed browser origins, comma-separated (APP_URL is always allowed)
CORS_ORIGINS=
PORT=3001
NODE_ENV=development
# 1 = log every SQL statement Prisma sends (local debugging only; off by default). Warnings are always logged.
PRISMA_LOG_QUERIES=0

# --- Other services ---
# redis:// or rediss:// with a host; percent-encode special characters (/ # ? @) in the password.
REDIS_URL=redis://localhost:6379

# --- Email (Resend) ---
# Optional secret. Without it no email is sent: invites and admin password resets show the temporary
# password once to the admin, forgot-password sends nothing, and the log holds only
# "[Email] <kind> not sent: email is not configured (user <id>)" (docs/SECURITY_SETUP.md §9).
RESEND_API_KEY=
# Optional sender, on a domain verified in Resend: "address@domain" or "Name <address@domain>".
# Blank uses the default: Raqib by Momentum Labs <noreply@raqib.momentumlabs.ps>
EMAIL_FROM=

# --- Seed (prisma/seed.ts) ---
# Required outside development. The seed never runs when NODE_ENV=production.
SEED_PASSWORD=
