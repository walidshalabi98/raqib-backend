generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

enum OrgType {
  local_ngo
  ingo
  donor
  government
  other
}

enum SubscriptionStatus {
  trial
  active
  suspended
  expired
}

enum UserRole {
  platform_admin
  org_admin
  me_officer
  donor_viewer
}

enum Language {
  en
  ar
}

enum Sector {
  education
  livelihoods
  health
  wash
  protection
  food_security
  governance
  agriculture
  gender
  youth
  other
  mhpss
  cash
  shelter
  climate_energy
}

enum DonorType {
  usaid // legacy: USAID stopped administering awards on 1 July 2025
  eu
  giz
  undp
  unicef
  sida
  other
  echo
  wfp
  unfpa
  fcdo
  un_women
}

enum ProjectStatus {
  setup
  framework_review
  active
  completed
  archived
}

enum DocumentType {
  proposal
  logframe
  theory_of_change
  baseline_report
  donor_guidelines
  budget
  other
}

enum ParsingStatus {
  pending
  processing
  completed
  failed
}

enum FrameworkStatus {
  draft
  expert_review
  client_review
  approved
  active
}

enum IndicatorLevel {
  impact
  outcome
  output
  activity
}

enum CollectionMethod {
  hh_survey
  fgd
  kii
  observation
  document_review
  participatory
  secondary_data
}

enum Frequency {
  monthly
  quarterly
  biannual
  annual
  per_cohort
  baseline_endline
}

enum IndicatorDirection {
  increase
  decrease
  maintain
}

// Where an indicator came from (knowledge/me-foundations.md §3).
enum IndicatorProvenance {
  library
  ai_suggested
  ai_generated
  imported
  manual
}

enum IndicatorStatus {
  on_track
  at_risk
  off_track
  not_started
  completed
}

enum AssessmentType {
  baseline
  midterm
  endline
  fgd_round
  kii_round
  observation_round
  survey_round
}

enum AssessmentStatus {
  requested
  scoping
  in_field
  data_cleaning
  analysis
  reporting
  delivered
}

enum QualitativeType {
  fgd_transcript
  kii_notes
  observation_checklist
  community_scorecard
  msc_story
  field_notes
}

enum Sentiment {
  positive
  neutral
  negative
  mixed
}

enum ReportType {
  monthly_progress
  quarterly_summary
  assessment_report
  donor_export
  annual_review
}

enum ReportStatus {
  draft
  published
}

enum NotificationType {
  off_track_alert
  assessment_ready
  report_generated
  framework_approved
  deadline_reminder
  new_data
}

model Organization {
  id                 String             @id @default(uuid())
  name               String
  nameAr             String?
  type               OrgType
  logoUrl            String?
  country            String
  city               String
  contactEmail       String
  contactPhone       String?
  subscriptionStatus SubscriptionStatus @default(trial)
  createdAt          DateTime           @default(now())
  users              User[]
  projects           Project[]
  webhookTokens      WebhookToken[]
  aiCalls            AiCall[]
}

// Per-organisation token for inbound webhooks (KoboToolbox, Manasati).
// Only the SHA-256 hash is stored; the plain token is shown once when created.
model WebhookToken {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tokenHash      String       @unique
  tokenPrefix    String // first characters, to help admins recognise the token
  createdById    String // user that data imported through this token is attributed to
  createdBy      User         @relation(fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())
  lastUsedAt     DateTime?
  revokedAt      DateTime?

  @@index([organizationId])
}

model User {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  email          String         @unique
  passwordHash   String
  fullName       String
  fullNameAr     String?
  role           UserRole
  languagePref   Language       @default(en)
  createdAt      DateTime       @default(now())
  lastLogin      DateTime?
  documents      Document[]
  dataPoints     DataPoint[]
  notifications  Notification[]
  webhookTokens  WebhookToken[]
}

model Project {
  id                  String               @id @default(uuid())
  organizationId      String
  organization        Organization         @relation(fields: [organizationId], references: [id])
  name                String
  nameAr              String?
  description         String?
  sector              Sector
  donor               String
  donorType           DonorType
  budgetUsd           Decimal?             @db.Decimal(12, 2)
  startDate           DateTime             @db.Date
  endDate             DateTime             @db.Date
  targetBeneficiaries Int?
  geographicScope     String?
  sectors             Sector[]             @default([]) // all sectors; `sector` stays the primary one
  humanitarian        Boolean              @default(false) // drives accountability rules and ECHO behaviour
  status              ProjectStatus        @default(setup)
  createdAt           DateTime             @default(now())
  documents           Document[]
  frameworks          Framework[]
  assessments         Assessment[]
  dataPoints          DataPoint[]
  qualitativeEntries  QualitativeEntry[]
  reports             Report[]
  beneficiaries       Beneficiary[]
  beneficiaryServices BeneficiaryService[]
  aiCalls             AiCall[]
  kpiSuggestions      KpiSuggestion[]
  kpiSuggestionRuns   KpiSuggestionRun[]
}

model Document {
  id                String        @id @default(uuid())
  projectId         String
  project           Project       @relation(fields: [projectId], references: [id])
  uploadedBy        String
  uploader          User          @relation(fields: [uploadedBy], references: [id])
  fileName          String
  fileUrl           String
  fileType          DocumentType
  fileSizeBytes     BigInt?
  parsedText        String? // extracted text with phone, ID and email numbers removed (safe to send to AI)
  aiAnalysis        Json? // the model's analysis of the document (documentParser); kept apart from parsedText
  // Uploaded as an FGD/KII transcript (qualitative upload): coded with the qualitative entry only,
  // never sent to document analysis, framework generation or assessments.
  qualitativeSource Boolean       @default(false)
  parsingStatus     ParsingStatus @default(pending)
  uploadedAt        DateTime      @default(now())
}

model Framework {
  id                String             @id @default(uuid())
  projectId         String
  project           Project            @relation(fields: [projectId], references: [id])
  version           Int                @default(1)
  status            FrameworkStatus    @default(draft)
  name              String?
  aiModelUsed       String?
  // Set when AI generation of this version failed (a safe message, never model output); such a
  // version is not used as the project's current framework.
  generationError   String?
  generatedAt       DateTime           @default(now())
  approvedAt        DateTime?
  approvedBy        String?
  indicators        Indicator[]
  resultNodes       ResultNode[]
  kpiSuggestions    KpiSuggestion[]
  kpiSuggestionRuns KpiSuggestionRun[]
}

// Results chain node: goal/impact → outcome → output (→ activity).
model ResultNode {
  id                String             @id @default(uuid())
  frameworkId       String
  framework         Framework          @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  parentId          String?
  parent            ResultNode?        @relation("ResultTree", fields: [parentId], references: [id], onDelete: Restrict)
  children          ResultNode[]       @relation("ResultTree")
  level             IndicatorLevel
  code              String // "Goal", "O1", "O1.1"
  text              String
  textAr            String?
  sortOrder         Int                @default(0)
  createdAt         DateTime           @default(now())
  indicators        Indicator[]
  kpiSuggestions    KpiSuggestion[]
  kpiSuggestionRuns KpiSuggestionRun[]

  @@unique([frameworkId, code])
  @@index([frameworkId])
  @@index([parentId])
}

model Indicator {
  id                   String           @id @default(uuid())
  frameworkId          String
  framework            Framework        @relation(fields: [frameworkId], references: [id])
  indicatorText        String
  indicatorTextAr      String?
  level                IndicatorLevel
  dataCollectionMethod CollectionMethod
  frequency            Frequency
  baselineValue        String?
  targetValue          String?
  currentValue         String?
  unit                 String?
  status               IndicatorStatus  @default(not_started)
  aiRationale          String?
  phases               Json // ["baseline", "midterm", "endline"]
  startDate            DateTime?
  endDate              DateTime?
  actualStartDate      DateTime?
  actualEndDate        DateTime?
  milestones           Json?
  responsibility       String?
  sortOrder            Int              @default(0)
  isApproved           Boolean          @default(false)
  createdAt            DateTime         @default(now())

  // Indicator reference sheet (knowledge/me-foundations.md §3)
  resultId              String?
  result                ResultNode?            @relation(fields: [resultId], references: [id], onDelete: SetNull)
  definition            String?
  calculation           Json? // { numerator, denominator, formula, rounding }
  direction             IndicatorDirection?
  disaggregation        Json? // ["sex", "age", "disability", ...]
  meansOfVerification   String?
  baselineDate          DateTime?              @db.Date
  baselineMethod        String?
  targetJustification   String?
  intermediateTargets   Json? // [{ date: "YYYY-MM-DD", value: "..." }]
  assumptions           String?
  libraryId             String?
  library               IndicatorLibraryEntry? @relation(fields: [libraryId], references: [id], onDelete: SetNull)
  standardReferenceCode String? // e.g. "GERF 2.38", "IASC MHPSS O5.4"
  provenance            IndicatorProvenance    @default(manual)
  aiModel               String?
  promptVersion         String?

  dataPoints          DataPoint[]
  beneficiaryServices BeneficiaryService[]

  // KPI Assistant (Phase 4)
  kpiRunsAsSource        KpiSuggestionRun[] @relation("KpiRunSourceIndicator")
  kpiAlternatives        KpiSuggestion[]    @relation("KpiAlternativeOfIndicator")
  acceptedFromSuggestion KpiSuggestion?     @relation("KpiAcceptedIndicator")

  @@index([resultId])
}

model Assessment {
  id                 String             @id @default(uuid())
  projectId          String
  project            Project            @relation(fields: [projectId], references: [id])
  type               AssessmentType
  status             AssessmentStatus   @default(requested)
  scopeDescription   String?
  sampleSize         Int?
  methodsIncluded    Json // ["hh_survey", "fgd", "kii"]
  priceUsd           Decimal?           @db.Decimal(10, 2)
  requestedAt        DateTime           @default(now())
  startedAt          DateTime?
  deliveredAt        DateTime?
  reportUrl          String?
  dataPoints         DataPoint[]
  qualitativeEntries QualitativeEntry[]
}

model DataPoint {
  id               String           @id @default(uuid())
  indicatorId      String
  indicator        Indicator        @relation(fields: [indicatorId], references: [id])
  assessmentId     String?
  assessment       Assessment?      @relation(fields: [assessmentId], references: [id])
  projectId        String
  project          Project          @relation(fields: [projectId], references: [id])
  value            String
  collectionDate   DateTime         @db.Date
  collectionMethod CollectionMethod
  dataSource       String?
  geographicArea   String?
  notes            String?
  attachments      Json?
  // Disaggregated values, e.g. { "sex": { "female": 120, "male": 98 }, "disability": { "yes": 12, "no": 206 } }
  breakdown        Json?
  createdAt        DateTime         @default(now())
  createdBy        String
  creator          User             @relation(fields: [createdBy], references: [id])
}

model QualitativeEntry {
  id               String          @id @default(uuid())
  assessmentId     String?
  assessment       Assessment?     @relation(fields: [assessmentId], references: [id])
  projectId        String
  project          Project         @relation(fields: [projectId], references: [id])
  entryType        QualitativeType
  title            String
  content          String
  participants     Int?
  location         String?
  dateConducted    DateTime?       @db.Date
  facilitator      String?
  themes           Json? // ["theme1", "theme2"]
  sentiment        Sentiment?
  linkedIndicators Json? // ["indicator-id-1", "indicator-id-2"]
  attachments      Json?
  createdAt        DateTime        @default(now())
}

model Report {
  id          String       @id @default(uuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id])
  type        ReportType
  title       String
  donorFormat DonorType?
  fileUrl     String?
  generatedAt DateTime     @default(now())
  periodStart DateTime?    @db.Date
  periodEnd   DateTime?    @db.Date
  aiNarrative String?
  status      ReportStatus @default(draft)
}

// Seed indicator library (source of truth: knowledge/indicator-library.json; load with `npm run seed:library`).
model IndicatorLibraryEntry {
  id                  String                       @id // e.g. "FS-01"
  sector              Sector
  tags                String[]
  level               IndicatorLevel
  name                String
  nameAr              String
  definition          String
  unit                String // number | percent | score | litres_per_person_per_day | ... (see library meta.enums.unit)
  calculation         Json? // { numerator, denominator, formula, aggregation }
  direction           IndicatorDirection
  disaggregation      String[]
  methods             CollectionMethod[]
  frequency           Frequency
  meansOfVerification String
  standardReference   Json? // { framework, code, url }
  standardFramework   String? // copy of standardReference.framework, for filtering
  isStandard          Boolean
  notes               String?
  version             String // library meta.version the entry was loaded from
  embedding           Unsupported("vector(1024)")? // Voyage voyage-4 (Phase 3)
  embeddingModel      String? // embedding model that produced `embedding`; a different model means re-embed
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  indicators          Indicator[]
  kpiSuggestions      KpiSuggestion[]

  @@index([sector])
  @@index([standardFramework])
}

// Deprecated: replaced by IndicatorLibraryEntry. Kept until its removal is approved (no table drops without approval).
model METemplate {
  id                   String                       @id @default(uuid())
  sector               Sector
  indicatorText        String
  indicatorTextAr      String?
  level                IndicatorLevel
  recommendedMethod    CollectionMethod
  recommendedFrequency Frequency
  typicalTarget        String?
  benchmarkPalestine   String?
  donorRelevance       Json? // ["usaid", "eu"]
  tags                 Json?
  embedding            Unsupported("vector(1536)")?
  createdAt            DateTime                     @default(now())
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String
  action        String
  entity        String
  entityId      String
  previousValue Json?
  newValue      Json?
  timestamp     DateTime @default(now())
}

enum Gender {
  male
  female
  other
}

enum AgeGroup {
  child_0_5
  child_6_11
  adolescent_12_17
  youth_18_24
  adult_25_59
  elderly_60_plus
}

enum BeneficiaryStatus {
  active
  completed
  dropped_out
  referred
}

model Beneficiary {
  id                String               @id @default(uuid())
  projectId         String
  project           Project              @relation(fields: [projectId], references: [id])
  fullName          String
  fullNameAr        String?
  gender            Gender
  age               Int?
  ageGroup          AgeGroup?
  location          String?
  governorate       String?
  phoneNumber       String?
  nationalId        String?
  householdSize     Int?
  vulnerabilityTags Json? // ["disabled", "female_headed_household", etc.]
  registrationDate  DateTime             @default(now())
  status            BeneficiaryStatus    @default(active)
  services          BeneficiaryService[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model BeneficiaryService {
  id            String      @id @default(uuid())
  beneficiaryId String
  beneficiary   Beneficiary @relation(fields: [beneficiaryId], references: [id])
  projectId     String
  project       Project     @relation(fields: [projectId], references: [id])
  serviceType   String // e.g., "cash_assistance", "training", "psychosocial_support"
  description   String?
  dateProvided  DateTime
  quantity      Decimal?    @db.Decimal(10, 2)
  unit          String? // e.g., "USD", "sessions", "kits"
  indicatorId   String?
  indicator     Indicator?  @relation(fields: [indicatorId], references: [id])
  notes         String?
  createdAt     DateTime    @default(now())
}

enum AiCallStatus {
  success
  refusal
  max_tokens
  invalid_output
  error
}

// One row per AI model call (BUILD_GUIDE Phase 3): model, prompt versions, tokens, latency and
// estimated cost. Never stores prompts, model output or personal data.
model AiCall {
  id                  String        @id @default(uuid())
  feature             String // e.g. "framework.indicators"
  model               String // model requested (AI_MODEL_MAIN / AI_MODEL_FAST)
  servedModel         String? // model that produced the answer (differs after a server-side fallback)
  promptVersion       String
  systemPromptVersion String?
  status              AiCallStatus
  stopReason          String?
  errorType           String? // error class name only, never the message
  attempts            Int           @default(1)
  inputTokens         Int           @default(0)
  outputTokens        Int           @default(0)
  cacheReadTokens     Int           @default(0)
  cacheWriteTokens    Int           @default(0)
  latencyMs           Int
  estimatedCostUsd    Decimal?      @db.Decimal(12, 6)
  organizationId      String?
  organization        Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  projectId           String?
  project             Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt           DateTime      @default(now())

  @@index([createdAt])
  @@index([organizationId, createdAt])
  @@index([feature, createdAt])
  @@index([projectId, createdAt])
}

// ------------------------------------------------------------------ Phase 4: KPI Assistant

enum SuggestionStatus {
  pending
  accepted
  edited_accepted
  rejected
  expired
}

enum SuggestionRejectReason {
  not_relevant
  too_costly_to_measure
  donor_not_required
  duplicate
  wording
  other
}

enum KpiRunScope {
  framework
  result
  alternatives
}

enum KpiRunStatus {
  running
  completed
  failed
}

/// One "Suggest KPIs" request (kpi-assistant-spec §A6): status, progress step, run-level warnings, cost. Polled by the UI.
/// Runs are never pruned: their suggestions (feedback history) reference them.
model KpiSuggestionRun {
  id                 String          @id @default(uuid())
  projectId          String
  project            Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  frameworkId        String
  framework          Framework       @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  scope              KpiRunScope
  resultId           String?
  result             ResultNode?     @relation(fields: [resultId], references: [id], onDelete: SetNull)
  sourceIndicatorId  String?
  sourceIndicator    Indicator?      @relation("KpiRunSourceIndicator", fields: [sourceIndicatorId], references: [id], onDelete: SetNull)
  sourceSuggestionId String?
  sourceSuggestion   KpiSuggestion?  @relation("KpiRunSourceSuggestion", fields: [sourceSuggestionId], references: [id], onDelete: SetNull)
  status             KpiRunStatus    @default(running)
  step               String          @default("context") // context | retrieval | model | validation | saving | done
  errorCode          String? // KpiErrorCode
  error              String? // safe message, never model or document text
  frameworkWarnings  Json            @default("[]") // KpiWarning[]
  suggestionCount    Int             @default(0)
  retrieval          String? // vector | keyword
  model              String?
  promptVersion      String?
  modelCalls         Int             @default(0)
  embeddingCalls     Int             @default(0)
  inputTokens        Int             @default(0)
  outputTokens       Int             @default(0)
  estimatedCostUsd   Decimal?        @db.Decimal(12, 6)
  latencyMs          Int?
  requestedBy        String? // user id; no foreign key (users are deleted), like Framework.approvedBy
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt // heartbeat (no database default: raw SQL inserts must set it)
  finishedAt         DateTime?
  suggestions        KpiSuggestion[] @relation("KpiRunSuggestions")

  @@index([projectId, createdAt])
  @@index([frameworkId, status])
}

/// A suggested indicator (kpi-assistant-spec §A5). Rejected rows are feedback history (orgPreferences): never delete them.
model KpiSuggestion {
  id                        String                  @id @default(uuid())
  projectId                 String
  project                   Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  frameworkId               String
  framework                 Framework               @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  runId                     String
  run                       KpiSuggestionRun        @relation("KpiRunSuggestions", fields: [runId], references: [id], onDelete: NoAction)
  resultId                  String?
  result                    ResultNode?             @relation(fields: [resultId], references: [id], onDelete: SetNull)
  level                     IndicatorLevel
  sortOrder                 Int                     @default(0)
  payload                   Json // ValidatedSuggestion without warnings/qualityScore/qualityBand (src/services/kpi/types.ts), with `draft`
  qualityScore              Int
  warnings                  Json                    @default("[]") // KpiWarning[]
  libraryId                 String?
  library                   IndicatorLibraryEntry?  @relation(fields: [libraryId], references: [id], onDelete: SetNull)
  isCustom                  Boolean                 @default(false)
  method                    CollectionMethod
  alternativeOfIndicatorId  String?
  alternativeOfIndicator    Indicator?              @relation("KpiAlternativeOfIndicator", fields: [alternativeOfIndicatorId], references: [id], onDelete: SetNull)
  alternativeOfSuggestionId String?
  alternativeOfSuggestion   KpiSuggestion?          @relation("KpiAlternativeOfSuggestion", fields: [alternativeOfSuggestionId], references: [id], onDelete: SetNull)
  alternatives              KpiSuggestion[]         @relation("KpiAlternativeOfSuggestion")
  sourceOfRuns              KpiSuggestionRun[]      @relation("KpiRunSourceSuggestion")
  status                    SuggestionStatus        @default(pending)
  model                     String
  promptVersion             String
  createdAt                 DateTime                @default(now())
  decidedAt                 DateTime?
  decidedBy                 String? // user id; no foreign key
  rejectReason              SuggestionRejectReason?
  rejectNote                String? // redacted when saved
  indicatorId               String?                 @unique
  indicator                 Indicator?              @relation("KpiAcceptedIndicator", fields: [indicatorId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([frameworkId, status])
  @@index([resultId])
  @@index([runId])
  @@index([libraryId, status])
}
