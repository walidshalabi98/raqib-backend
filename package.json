{
  "name": "raqib-backend",
  "version": "1.0.0",
  "description": "RAQIB M&E Platform - Backend & AI Engine",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "worker": "tsx src/jobs/worker.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx prisma/seed.ts",
    "storage:setup": "tsx scripts/storage-setup.ts",
    "storage:migrate": "tsx scripts/migrate-uploads.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint .",
    "seed:library": "tsx scripts/seed-library.ts",
    "verify:migration": "scripts/verify-migrations.sh",
    "ai:smoke": "tsx scripts/ai-smoke.ts",
    "eval:kpi": "tsx scripts/eval-kpi.ts",
    "ai-calls:prune": "tsx scripts/prune-ai-calls.ts",
    "redact:backfill": "tsx scripts/redact-stored-text.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@prisma/client": "^6.19.3",
    "@react-pdf/renderer": "^4.3.0",
    "@supabase/supabase-js": "^2.117.3",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.12",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.8.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "prisma": "^6.19.3",
    "resend": "^4.1.2",
    "tesseract.js": "^5.1.1",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.12.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "supertest": "^7.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "qs": "^6.16.0"
  }
}
